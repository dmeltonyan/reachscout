# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database ──────────────────────────────────────────────────────────────────
# Use the pooler (Transaction mode) for runtime; Direct for migrations.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL_DIRECT=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# ── Search provider ───────────────────────────────────────────────────────────
# Options: mock | brave | serper
SEARCH_PROVIDER=mock
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# ── Email verification provider ───────────────────────────────────────────────
# Options: mock | hunter | neverbounce
EMAIL_VERIFICATION_PROVIDER=mock
HUNTER_API_KEY=
NEVERBOUNCE_API_KEY=

# ── Outreach generation ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# ── Rate limits ───────────────────────────────────────────────────────────────
SEARCHES_PER_HOUR=10
PROFILES_PER_DAY=100
VERIFICATIONS_PER_DAY=25
EXPORTS_PER_DAY=5
